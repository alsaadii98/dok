# Maintainer: Ali H. Abdulhadi <a.h.alsaady1998@gmail.com>
# Prebuilt-binary package: no Rust toolchain required. The binary is the
# static musl build from the matching GitHub release.
pkgname=dok-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Docker output, made readable - what eza is to ls (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/alsaadii98/dok"
license=('MIT')
provides=('dok')
conflicts=('dok')
# The binary is already stripped and statically linked; a debug package
# would only ship an empty tree.
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/dok-$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/dok-$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('f3e4174394942ff74cf9fb534e76751a20b568413e1f6e8598986c92b0f8ce2c')
sha256sums_aarch64=('24bcc8ed5d27917599e248f73ebf4c9f744e2b323f02296fd29df6d1e628bd00')

package() {
  local dir="dok-$pkgver-$CARCH-unknown-linux-musl"
  install -Dm0755 "$dir/dok" "$pkgdir/usr/bin/dok"
  install -Dm0644 "$dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 "$dir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}

# Maintainer: Ali H. Abdulhadi <a.h.alsaady1998@gmail.com>
pkgname=dok
pkgver=0.2.1
pkgrel=1
pkgdesc="Docker output, made readable - what eza is to ls"
arch=('x86_64' 'aarch64')
url="https://github.com/alsaadii98/dok"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
provides=('dok')
conflicts=('dok-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f7762dacde4d29c0fc8b762549cd4902a986443799af010e30e44e7e21e31557')

prepare() {
  cd "dok-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "dok-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "dok-$pkgver"
  install -Dm0755 "target/release/dok" "$pkgdir/usr/bin/dok"
  install -Dm0644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
